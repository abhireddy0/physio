# Production URL of the website (no trailing slash). Used for canonical URLs,
# Open Graph tags, sitemap.xml, robots.txt and the vCard.
# Leave empty for staging/preview builds: the site is then built with
# noindex + "Disallow: /".
VITE_SITE_URL=

# Set to "false" to force noindex even when VITE_SITE_URL is set
# (e.g. a staging deployment on its own domain).
VITE_ALLOW_INDEXING=true
